    "sources": { "type": "object", "additionalProperties": true },
    "ocr": { "type": "object", "additionalProperties": true },
    "extraction": { "type": "object", "additionalProperties": true },
    "categorization": { "type": "object", "additionalProperties": true },
    "processing": { "type": "object", "additionalProperties": true },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": true
}
